e/.test(s))return r.effective_rate;if(/sale.*price|last_sale_price/.test(s))return r.last_sale_price;if(/sale.*year|last_sale_year/.test(s))return r.last_sale_year;if(/pcl_mun|municipality.*code/.test(s))return r.pcl_mun;if(/county.*municipality.*code|cd_code/.test(s))return r.cd_code;if(/additional.*lot/.test(s))return r.additional_lots_1||r.additional_lots_2;if(/facility.*name/.test(s))return r.facility_name;if(/gis.*pin/.test(s))return r.gis_pin;if(/old.*property.*id/.test(s))return r.old_property_id;if(/parcel.*guid/.test(s))return r.parcel_guid;return null}
