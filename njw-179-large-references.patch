" class="ms-modal" hidden></div>`;bind()}function bind(){$$('[data-jump]').forEach(b=>b.onclick=()=>$('#'+b.dataset.jump)?.scrollIntoView({behavior:'smooth'}));$$('[data-play]').forEach(b=>b.onclick=()=>{S.play=PLAYBOOKS.find(p=>p.id===b.dataset.play)||PLAYBOOKS[0];S.channels=new Set(S.play.channels);render()});$$('[data-channel]').forEach(b=>b.onclick=()=>{S.channels.has(b.dataset.channel)?S.channels.delete(b.dataset.channel):S.channels.add(b.dataset.channel);b.classList.toggle('on',S.channels.has(b.dataset.channel))});$('#ms-new').onclick=()=>$('#builder').scrollIntoView({behavior:'smooth'});$('#ms-preview').onclick=preview;$('#ms-save').onclick=saveCampaign}function preview(){const budget=budgetValue(),cap=capValue(),m=$('#ms-modal');m.hidden=false;m.innerHTML=`<div class="ms-modal-card"><div class="ms-modal-head"><div><span class="ms-eyebrow">CAMPAIGN REVIEW</span><h2>${esc($('#ms-name').value||'Campaign')}</h2></div><button data-close>×</button></div><p><b>${S.handoff?.property_keys?.length||0}</b> properties · ${esc(S.play.title)} · ${[...S.channels].map(providerName).map(esc).join(', ')}</p><p><b>Working budget:</b> ${dollars(budget)}${cap?` · <b>Hard cap:</b> ${dollars(cap)}`:''}</p><div class="ms-sequence">${S.play.sequence.map((x,i)=>`<div class="ms-step"><em>${i+1}</em><div><b>${esc(x[1])}</b><small>${esc(providerName(x[0]))}</small></div><small>${esc(x[2])}</small></div>`).join('')}</div><div class="ms-warning" style="margin-top:14px">This is a draft plan. No provider will receive data and no payment will be collected until a later launch approval step.</div></div>`;$('[data-close]',m).onclick=()=>m.hidden=true;m.onclick=e=>{if(e.target===m)m.hidden=true}}async function saveCampaign(){const name=$('#ms-name').value.trim();if(!name){toast('Enter a campaign name.');return}const keys=S.handoff?.property_keys||[],reason=$('#ms-reason').value.trim(),goal=$('#ms-goal').value.trim()||S.play.goal,profession=$('#ms-profession').value,budget=budgetValue(),cap=capV