 (function(){const r=NJPropertyModel.load();const money=v=>Number.isFinite(v)?new Intl.NumberFormat('en-US',{style:'currency',currency:'USD',maximumFractionDigits:0}).format(v):'—';const pct=v=>Number.isFinite(v)?`${(v*100).toFixed(1)}%`:'—';document.getElementById('address').textContent=r.property.address||'No property selected';document.getElementById('location').textContent=[r.property.municipality,r.property.county].filter(Boolean).join(', ')||'Complete any analysis tool to begin building this report.';document.getElementById('assessed').textContent=money(r.property.assessedValue);document.getElementById('market').textContent=money(r.property.estimatedMarketValue);const ar=NJPropertyModel.assessmentRatio(r);document.getElementById('ratio').textContent=pct(ar);document.getElementById('cod').textContent=Number.isFinite(r.municipalityMetrics.cod)?r.municipalityMetrics.cod.toFixed(1):'—';document.getElementById('completion').textContent=`${NJPropertyModel.completeness(r)}%`;let parts=[];if(ar){parts.push(`The saved property data implies an assessment ratio of <strong>${pct(ar)}</strong>.`)}if(Number.isFinite(r.analysis.neighborhoodMedianRatio)){const diff=ar-r.analysis.neighborhoodMedianRatio;parts.push(`The neighborhood comparison median is <strong>${pct(r.analysis.neighborhoodMedianRatio)}</strong>${ar?`, placing the subject ${Math.abs(diff*100).toFixed(1)} percentage points ${diff>0?'above':'below'} that benchmark.`:'.'}`)}if(r.analysis.appealLevel){parts.push(`The current appeal screening result is <strong>${r.analysis.appealLevel}</strong>.`)}if(Number.isFinite(r.municipalityMetrics.cod)){parts.push(`The municipality's latest saved residential COD is <strong>${r.municipalityMetrics.cod.toFixed(1)}</strong>, which describes assessment uniformity across residential sales rather than proving whether this individual property is over-assessed.`)}document.getElementById('summary').innerHTML=parts.length?parts.join(' '):'Not enough saved information is available to create an assessment insight yet.';const events=[];if(r.property.assessedValue)events.push(['Assessment entered',money(r.property.assessedValue)]);if(r.property.estimatedMarketValue)events.push(['Market value estimated',money(r.property.estimatedMarketValue)]);if(Number.isFinite(r.analysis.neighborhoodMedianRatio))events.push(['Neighborhood benchmark saved',pct(r.analysis.neighborhoodMedianRatio)]);if(r.analysis.appealLevel)events.push(['Appeal screening completed',r.analysis.appealLevel]);if(Number.isFinite(r.municipalityMetrics.cod))events.push(['Municipal fairness data loaded',`COD ${r.municipalityMetrics.cod.toFixed(1)}`]);if(events.length)document.getElementById('timeline').innerHTML=events.map(e=>`<li><b>${e[0]}</b><span>${e[1]}</span></li>`).join('');})();
